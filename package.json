{
  "name": "biyong-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "tsx scripts/verify-phase0.ts",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "react-native-reanimated": "~3.16.1",
      "metro": "0.81.5",
      "metro-cache": "0.81.5",
      "metro-config": "0.81.5",
      "metro-core": "0.81.5",
      "metro-resolver": "0.81.5",
      "metro-runtime": "0.81.5",
      "metro-source-map": "0.81.5",
      "metro-transform-plugins": "0.81.5",
      "metro-transform-worker": "0.81.5"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
