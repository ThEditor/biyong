{
  "name": "@biyong/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts || true"
  },
  "dependencies": {
    "@biyong/schemas": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@biyong/config": "workspace:*",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
